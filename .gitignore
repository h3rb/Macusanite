# Local tool state, not part of the project: this checkout's workspace id.
.freebuff/

node_modules/
dist/
# Collected build output: copied out of src-tauri/target/release by
# scripts/collect-release.mjs, so both are generated.
release/
src-tauri/target/
src-tauri/gen/
logs/
*.log
# The app's shared data folder. On this machine it happens to sit inside the
# checkout (Documents/Macusanite), so keep the recorded vault paths out of git;
# the app recreates the folder and its README whenever it starts.
localstorage/
.DS_Store
reference-vault/.macusanite/logs/
reference-vault/.macusanite/state.json
reference-vault/.macusanite/history.json
# The index cache is derived from the veins: it is rebuilt on the next open.
reference-vault/.macusanite/index.json
# Tauri updater signing keys: the private key must never be committed.
*.key
*.key.pub
.tauri/
